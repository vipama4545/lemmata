# Copy to .env on the deployment host and fill in. Compose reads this same file twice: once
# to substitute ${...} into docker-compose.prod.yml, and once to hand the variables to the
# containers, so there is only ever one file to keep straight.
#
# DATABASE_URL, HOST and PORT are deliberately absent — docker-compose.prod.yml sets those,
# because they describe the container network rather than the deployment.

NODE_ENV=production

# ---------------------------------------------------------------------------------- images

# Which build to run. Both images live in one private Docker Hub repo and are told apart by
# a tag prefix, so this is the half they share: youruser/yourrepo:server-$TAG and
# :web-$TAG. Rolling back is this line changed and `up -d` again, which is the whole reason
# it is not `latest`.
TAG=20260805
REGISTRY=youruser/yourrepo

# ------------------------------------------------------------------------------ the edge

# The loopback port the stack listens on, for the proxy already running on this host to
# point at. Nothing but that proxy can reach it. TLS and the hostname are the proxy's job,
# so lemmata.fyi does not appear here — only in the two auth URLs below.
WEB_PORT=5050

# ------------------------------------------------------------------------------- postgres

POSTGRES_USER=georgian
POSTGRES_DB=georgian_dict
# openssl rand -hex 24 — stick to hex or base32. This ends up inside a postgres:// URL, so
# a password with @ : / or # in it has to be percent-encoded, and that is a bad afternoon.
POSTGRES_PASSWORD=

# ----------------------------------------------------------------------------------- auth

# Both the same origin, which is the whole point of the single-origin deployment: auth.ts
# compares them, and only when they match does the session cookie stay a first-party
# SameSite=Lax one. Change these together or not at all.
BETTER_AUTH_URL=https://lemmata.fyi
WEB_ORIGIN=https://lemmata.fyi

# openssl rand -base64 32
# Rotating this signs everyone out. Nothing else is lost — sessions are the only thing it
# protects, and the study records are keyed to the account.
BETTER_AUTH_SECRET=

# https://discord.com/developers/applications -> your app -> OAuth2.
# The redirect URL registered there must be exactly:
#   https://lemmata.fyi/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ----------------------------------------------------------------------------------- mail

# Required in production: the server refuses to start without both. Development is the case
# where leaving them blank prints mail to the terminal instead.
# Mailgun -> Sending -> Domain settings -> API keys, and the sending domain itself.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Only for a domain created in Mailgun's EU region, which is not reachable on the US host.
# A wrong region answers a well-formed send with "Domain not found".
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Must be on MAILGUN_DOMAIN, or every send is rejected.
MAIL_FROM_EMAIL=no-reply@lemmata.fyi
MAIL_FROM_NAME=Lemmata
