# Copy to .env and fill in. One file at the repo root covers both apps.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Matches docker-compose.yml. `npm run db:up` starts it.
DATABASE_URL=postgres://georgian:georgian@localhost:5433/georgian_dict

# Where this server is reachable. Better Auth builds its OAuth callback URLs from it, so it
# has to be the address Discord will redirect back to — not a container-internal one.
BETTER_AUTH_URL=http://localhost:4000

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the browser app is served from. In development Vite proxies /api and /rpc through to
# the server, so the browser only ever sees this origin and the session cookie is
# first-party. Point the two at the same origin in production if you can — see the README.
WEB_ORIGIN=http://localhost:5173

# https://discord.com/developers/applications -> your app -> OAuth2.
# Add this exact redirect URL there: http://localhost:4000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Mailgun -> Sending -> Domain settings -> API keys, and the sending domain itself.
# Leave both blank in development and mail is printed to the server's terminal instead of
# being sent, sign-in links included. Both are required when NODE_ENV=production.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Only for a domain created in Mailgun's EU region, which is not reachable on the US host:
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# The From address. It has to be on MAILGUN_DOMAIN or Mailgun refuses to send as it.
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Georgian Dictionary
