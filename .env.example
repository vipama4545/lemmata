# Copy to .env and fill in. One file at the repo root covers both apps.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Matches docker-compose.yml. `npm run db:up` starts it.
DATABASE_URL=postgres://georgian:georgian@localhost:5433/georgian_dict

# Where this server is reachable. Better Auth builds its OAuth callback URLs from it, so it
# has to be the address Discord will redirect back to — not a container-internal one.
BETTER_AUTH_URL=http://localhost:4000

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the browser app is served from. In development Vite proxies /api and /rpc through to
# the server, so the browser only ever sees this origin and the session cookie is
# first-party. Point the two at the same origin in production if you can — see the README.
WEB_ORIGIN=http://localhost:5173

# https://discord.com/developers/applications -> your app -> OAuth2.
# Add this exact redirect URL there: http://localhost:4000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The Georgian tagger, if you are running one: `npm run analyser:up` starts it on 8000.
# Leave it blank and story linking works exactly as it always has — spellings matched
# against the lexicon, with ambiguous ones decided by the order of the words table. Set it
# and the resolver gets a part of speech per occurrence and can tell და "and" from და
# "sister". Nothing else reads it and nothing fails without it. See the README.
ANALYSER_URL=

# The voice, if you are running one: `npm run tts:up` starts it on 8001. Leave it blank and
# the story reader shows no player at all — no audio anywhere, and nothing else different.
# Set it and a story can be read aloud, a word at a time, with the reader following along.
TTS_URL=

# Where the synthesised audio is kept, and how large it may get before the least recently
# played files are dropped. Both have defaults worth keeping: the repo root, and 2 GB, which
# is about 167 hours of speech. Nothing in here is content — every file is remade on demand
# from the text it was hashed from — so the ceiling is a disk budget and nothing more.
# TTS_CACHE_DIR=
# TTS_CACHE_MAX_BYTES=

# Where uploads used to be kept, and the largest single file taken. Uploads themselves —
# quiz audio, lesson pictures and recordings — now live in the database, so MEDIA_DIR is only
# read by `npm run db:media-import` and by the cleanup that removes an old file when its row
# is deleted. A fresh deployment can leave it unset. MEDIA_MAX_BYTES still bounds an upload,
# and 8 MB is a sensible default.
#
# The database is now the only copy of anything anyone uploaded, so it is the thing that wants
# backing up. TTS_CACHE_DIR remains a cache that evicts itself and is worth backing up to
# nobody.
# MEDIA_DIR=
# MEDIA_MAX_BYTES=

# Mailgun -> Sending -> Domain settings -> API keys, and the sending domain itself.
# Leave both blank in development and mail is printed to the server's terminal instead of
# being sent, sign-in links included. Both are required when NODE_ENV=production.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Only for a domain created in Mailgun's EU region, which is not reachable on the US host:
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# The From address. It has to be on MAILGUN_DOMAIN or Mailgun refuses to send as it.
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Georgian Dictionary
