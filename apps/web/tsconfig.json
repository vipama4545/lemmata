{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",

    // Mirrors the `resolve.alias` entry in vite.config.ts. shadcn's components are published
    // importing themselves through it, so the alias has to exist for them to compile.
    // No `baseUrl`: TypeScript 7 removed it, and paths now resolve against this file.
    "paths": {
      "@/*": ["./src/*"]
    },

    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedSideEffectImports": true,

    // Still off, and now for a second reason. The app no longer imports any JSON — the
    // lexicon arrives over oRPC and is typed by @georgian/shared/contract — so there is
    // nothing left for it to resolve, and leaving it off keeps the door shut on anyone
    // re-importing a 2.7 MB file into the bundle by accident.
    "resolveJsonModule": false
  },
  "include": ["src"]
}
